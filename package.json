{
  "name": "nexova-monorepo",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./uis/*\" dev",
    "dev:website": "pnpm --filter website dev",
    "dev:backoffice": "pnpm --filter backoffice dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && pnpm test:site",
    "build:site": "tailwindcss -i tailwind.css -o styles.css --minify && node scripts/build-site.mjs",
    "watch:site": "tailwindcss -i tailwind.css -o styles.css --watch",
    "serve:site": "pnpm build:site && npx http-server@14.1.1 dist -p 8080 -a 0.0.0.0 -d false -c-1",
    "test:site": "node --test \"tests/site/**/*.test.*\""
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
